# RAG-Bench Environment Configuration
# Copy this to .env: cp .env.example .env

# ── LLM Backend ──

# Options: ollama, openai, anthropic
RAG_LLM_BACKEND=ollama

# Model name (Ollama: gemma2:27b, OpenAI: gpt-4, etc.)
RAG_LLM_MODEL=gemma2:27b

# Base URL (Docker: http://ollama:11434, local: http://localhost:11434)
RAG_LLM_BASE_URL=http://ollama:11434

# Ollama host port — change if 11434 is already in use
# OLLAMA_PORT=11434

# API key for OpenAI/Anthropic backends
# OPENAI_API_KEY=sk-xxx

# ── API ──

# API port (default: 8000)
# RAG_API_PORT=8000

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ── Reranker ──

# Cross-encoder model (default: BAAI/bge-reranker-v2-m3)
# RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
