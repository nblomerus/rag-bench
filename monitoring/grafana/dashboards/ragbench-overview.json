      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 19 },
      "id": 12,
      "targets": [{ "expr": "rate(rag_queries_rejected_total[5m])", "legendFormat": "Rejected/s" }],
      "title": "Rejected Queries (429)",
