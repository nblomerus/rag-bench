      "title": "Traffic",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" } },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "options": { "legend": { "displayMode": "list" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(rate(rag_queries_total[5m]))", "legendFormat": "Total" },
        { "expr": "rate(rag_queries_total{status=\"success\"}[5m])", "legendFormat": "Success" },
        { "expr": "rate(rag_queries_total{status=\"deflected\"}[5m])", "legendFormat": "Deflected" },
        { "expr": "rate(rag_queries_total{status=\"error\"}[5m])", "legendFormat": "Error" }
      ],
      "title": "Query Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 10 }] } } },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
