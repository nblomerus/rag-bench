      "targets": [
        { "expr": "histogram_quantile(0.90, sum(rate(rag_retrieval_duration_seconds_bucket[5m])) by (le))", "legendFormat": "Retrieval p90" },
        { "expr": "histogram_quantile(0.90, sum(rate(rag_generation_duration_seconds_bucket[5m])) by (le))", "legendFormat": "Generation p90" },
        { "expr": "histogram_quantile(0.90, sum(rate(rag_reranking_duration_seconds_bucket[5m])) by (le))", "legendFormat": "Reranking p90" }
      ],
      "title": "Pipeline Breakdown (p90)",
